{
  "name": "dsh-connect-teleagent",
  "version": "1.1.1",
  "description": "DeepSeek Harness 插件：接入中国电信天翼 AI 星辰超级智能体（TeleAgent），修正 v1 云网关签名（两轮 HMAC-SHA256），支持积分/每日签到与输入框内账号条",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "build": "node scripts/build-client.mjs",
    "test": "node tests/sign.test.mjs && node tests/apply.test.mjs && node tests/credits.test.mjs && node tests/client.test.mjs && node tests/model-config.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-commands": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-credentials": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvinhuang0509-design/dsh-connect-teleagent.git"
  },
  "homepage": "https://github.com/alvinhuang0509-design/dsh-connect-teleagent#readme",
  "bugs": {
    "url": "https://github.com/alvinhuang0509-design/dsh-connect-teleagent/issues"
  },
  "author": "alvinhuang0509-design",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "teleagent",
    "superagent",
    "teleai",
    "china-telecom",
    "model-provider",
    "credits",
    "星辰智能体"
  ],
  "license": "MIT"
}
